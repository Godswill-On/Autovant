# Copy this file to ".env" and fill it in. Never share or upload the .env file.

PORT=3000
NODE_ENV=production

# The password you will type on /admin. Use a long passphrase.
ADMIN_PASSWORD=change-this-to-a-long-passphrase

# A random string used to sign your login. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-the-64-character-random-string-here
